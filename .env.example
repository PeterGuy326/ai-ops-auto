# ====== 数据库 ======
# SQLite (默认开发) 或 PostgreSQL
DATABASE_URL=sqlite:///./data/ai_ops.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ai_ops

# ====== 凭证加密 ======
# 只用于加密数据库 Account.encrypted_credential 中的 credential blob，必须保密。
# 外部 CLI/浏览器的 HOME、cookie、OAuth token 和 persistent profile 文件不受 Fernet 保护，
# 需另用 0700/0600 权限、主机隔离和备份策略保护。生成方法：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ====== LLM ======
# 至少配一个 driver。默认 driver 由 LLM_DEFAULT 控制。
LLM_DEFAULT=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# 使用 OpenAI 兼容网关时，将 OPENAI_BASE_URL / OPENAI_MODEL
# 替换为你自己有权访问的端点和模型（含兼容的 DeepSeek/DashScope
# 服务）；LLM_DEFAULT 仍填写 openai。不要提交真实 key。

# ====== 可选视频生成服务（HappyHorse 兼容协议）======
WUKONG_API_KEY=
WUKONG_VIDEO_JOBS_URL=
WUKONG_VIDEO_MODEL=happyhorse-1.0-t2v

# ====== 外部工具路径 ======
# 生产/可审计环境必须锁定 docs/external-tools.md 记录的 commit；不要跟随上游 HEAD。
EXTERNAL_SAU_PATH=./external/social-auto-upload
EXTERNAL_MPT_PATH=./external/MoneyPrinterTurbo
# MPT CLI 禁止使用 PATH python；必须指向 EXTERNAL_MPT_PATH 内的独立 venv。
MPT_PYTHON=./external/MoneyPrinterTurbo/.venv/bin/python

# ====== FunClip · 智能视频剪辑（ASR + 文字稿切片）======
# clone: git clone https://github.com/modelscope/FunClip external/FunClip
# venv:  cd external/FunClip && python -m venv .venv && .venv/bin/pip install -r requirements.txt
# 详见 docs/funclip-setup.md
FUNCLIP_PATH=./external/FunClip
FUNCLIP_PYTHON=./external/FunClip/.venv/bin/python
FUNCLIP_TIMEOUT_SECONDS=1800
FUNCLIP_OUTPUT_ROOT=./data/clips

# ====== 外部工具 URL（独立服务方式）======
# 优先使用 URL；URL 留空则 fallback 到 PATH + subprocess
# 当前 SAU HTTP 集成本身无认证，只能使用 loopback/可信私网，禁止直连公网。
# HTTP 路径只映射小红书、视频号、抖音和快手；已审计 CLI 只含小红书、抖音、快手和 B 站。
EXTERNAL_SAU_URL=
SAU_CLI_TIMEOUT_SECONDS=1500
EXTERNAL_MPT_URL=
EXTERNAL_XHS_MCP_URL=

# MPT 的 x-api-key（与 MPT config.toml 的 app.api_key 一致；为空 = MPT 未启用鉴权）
MPT_API_KEY=
MPT_CLI_TIMEOUT_SECONDS=1800

# ====== 知乎 CLI canary（第三方 pyzhihu-cli==0.2.4）======
# 默认关闭；先在专用测试账号完成 docs/publishing-sop.md 的 canary 再开启。
# 安装到独立 tool 环境，不要把它混入控制面 venv：
#   uv tool install 'pyzhihu-cli==0.2.4'
ZHIHU_CLI_ENABLED=false
ZHIHU_CLI_BIN=zhihu
ZHIHU_CLI_TIMEOUT_SECONDS=300
# 每个 ai-ops account_id 会使用独立 HOME；这里不得填写 cookie/token。HOME 内登录态是磁盘敏感
# 文件而非 Fernet 密文。二维码只由 `ai-ops zhihu-login <account_id>` 在可信终端触发；
# `POST /accounts/{id}/login` 在 CLI 路径仅验证现有磁盘登录态。
ZHIHU_CLI_PROFILE_ROOT=./data/cli_profiles/zhihu
ZHIHU_CLI_ASSET_ROOT=./data
ZHIHU_CLI_MAX_CONTENT_BYTES=60000
ZHIHU_CLI_MAX_IMAGE_BYTES=20971520
ZHIHU_CLI_MAX_TOTAL_IMAGE_BYTES=52428800

# ====== YouTube uploader CLI canary（v1.25.5）======
# 使用 YouTube Data API；client_secrets/token 只放在每账号 profile 中，不提交 Git，且不受
# 数据库 Fernet 加密保护。上游没有 auth-only 命令；首次 OAuth 必须在可信终端手工完成，
# 必要时会与第一次 private canary 上传绑定，worker 不会也不应该代为登录。
YOUTUBE_UPLOADER_ENABLED=false
YOUTUBE_UPLOADER_BIN=youtubeuploader
YOUTUBE_UPLOADER_TIMEOUT_SECONDS=1500
YOUTUBE_UPLOADER_PROFILE_ROOT=./data/cli_profiles/youtube
YOUTUBE_UPLOADER_ASSET_ROOT=./data
YOUTUBE_UPLOADER_MAX_VIDEO_BYTES=21474836480

# ====== Third-party Publisher plugins (trusted in-process Python code) ======
# Empty means no third-party entry point is imported. Enabling a selector is a
# code-execution authorization, not a sandbox boundary. Pin the distribution
# version/hash in deployment tooling, then validate it with `ai-ops plugins doctor`.
# JSON array; each item binds normalized distribution + versioned entry-point name.
PUBLISHER_PLUGIN_ALLOWLIST=[]

# ====== 调度 ======
# 当前只实现 APScheduler。
SCHEDULER_BACKEND=apscheduler
# cron（健康检查、日报/周报）的业务时区；一次性任务内部统一按 UTC。
SCHEDULER_TIMEZONE=Asia/Shanghai
# 后台扫描持久任务的间隔。
SCHEDULER_POLL_SECONDS=15
# 同时执行的发布任务上限，避免 backlog 一次打开过多浏览器。
SCHEDULER_MAX_CONCURRENCY=4
# 1h/24h/7d 指标任务的外部调用超时、owner 租约、重试、独立并发与短锁等待。
METRICS_TASK_COLLECTION_TIMEOUT_SECONDS=120
METRICS_TASK_LEASE_SECONDS=300
METRICS_TASK_MAX_ATTEMPTS=5
METRICS_TASK_RETRY_BASE_SECONDS=300
METRICS_TASK_MAX_CONCURRENCY=4
METRICS_TASK_ACCOUNT_LOCK_TIMEOUT_SECONDS=1
# 第一次重试的基础退避秒数（后续指数增长）。
JOB_RETRY_BASE_SECONDS=60
# 单次 publisher 执行超时；超时后需先去平台核验，不会盲目自动重发。
JOB_EXECUTION_TIMEOUT_SECONDS=1800
# 进程硬崩溃后 RUNNING 任务的失联判定时间；必须大于上述执行超时。
JOB_RUNNING_TIMEOUT_SECONDS=7200
# 同一账号的 publish/health profile 互斥等待上限；健康探活本身的单适配器超时。
ACCOUNT_OPERATION_LOCK_TIMEOUT_SECONDS=120
HEALTH_PROBE_TIMEOUT_SECONDS=60
# 安全默认：false 只禁止后台扫描器自动真发布，不会禁用显式管理执行端点；持有 API_KEY 的
# 调用方仍可调用 POST /jobs/{id}/run 等产生外部副作用。设为 true 前先完成审核状态迁移、
# 账号隔离和单平台验证，并在外部权限边界确保发布授权由人控制。
AUTO_PUBLISH_ENABLED=false

# ====== 风控 ======
# 同账号 64-bit simhash 查重的 Hamming 距离；低于该整数即拦截。
SIMHASH_HAMMING_THRESHOLD=8

# ====== 浏览器兼容性与运营安全 ======
# 浏览器引擎：playwright_chromium / playwright_chrome_channel / patchright / camoufox
# 不同引擎的适配证据见平台能力矩阵；不存在“不被检测”的保证。
BROWSER_ENGINE=playwright_chrome_channel
# 是否无头；部分登录流程需要 headed 模式。
BROWSER_HEADLESS=False
# 可选网络代理；只使用有权访问且符合平台条款的服务。
BROWSER_PROXY=
# 同账号最小发布间隔（秒），默认 4h
PUBLISH_MIN_INTERVAL_SECONDS=14400
# 单账号每日发布上限
PUBLISH_MAX_PER_DAY=2
# 养号期天数（注册后多少天内禁发）
NURTURE_DAYS=7
# 排程抖动窗口（秒）— 分散同时到期任务，降低瞬时资源峰值。
PUBLISH_JITTER_SECONDS=600
# 文案是否执行可读性/风格整理。
XHS_HUMANIZE_ENABLED=True
# Stub selector paths are absent from the executable registry by default.
# Enable only for a dedicated-account canary after reading platform-capabilities.md.
BAIJIAHAO_PUBLISHER_ENABLED=false
SOHUHAO_PUBLISHER_ENABLED=false

# ====== GitHub Pages / 自有站点（可选）======
GITHUB_PAGES_PATH=./external/site
GITHUB_PAGES_ENGINE=hexo
GITHUB_PAGES_POSTS_DIR=source/_posts
GITHUB_PAGES_IMAGES_DIR=source/img
# 只会复制该目录内经过真实图片解码的非隐藏普通文件；不要指向项目根目录或凭证目录。
GITHUB_PAGES_ASSET_ROOT=./data/assets
GITHUB_PAGES_MAX_IMAGE_BYTES=20971520
GITHUB_PAGES_MAX_TOTAL_IMAGE_BYTES=104857600
GITHUB_PAGES_BUILD_TOOL=pnpm
GITHUB_PAGES_BUILD_TIMEOUT_SECONDS=600
GITHUB_PAGES_GIT_TIMEOUT_SECONDS=120
GITHUB_PAGES_LOCK_TIMEOUT_SECONDS=900
GITHUB_PAGES_REMOTE=origin
GITHUB_PAGES_BRANCH=main
GITHUB_PAGES_BASE_URL=
# 默认关闭的 GitHub Pages 部署/live readback 验证。`gh` 没有 Pages 专用子命令；
# 实现只调用固定的 `gh api` argv，并要求契约验收版本 2.97.0。
GITHUB_PAGES_GH_VERIFY_ENABLED=false
# 启用时必须填写精确 owner/repo；Publisher 会同时校验它与 git push remote 一致。
GITHUB_PAGES_REPOSITORY=
GITHUB_PAGES_GH_BIN=gh
GITHUB_PAGES_GH_VERSION=2.97.0
# 启用前，按运行平台从官方 release/checksum 验证实际 `gh` 文件，再填写小写 SHA-256；
# runtime 与 doctor 都会核对；runtime 只执行验收后生成的本轮私有只读副本，不能用版本字符串
# 代替二进制来源 pin。
GITHUB_PAGES_GH_SHA256=
# 只由运维在运行环境注入项目专用的最小权限 token（repository Pages:read）。
# 不要提交真实值、不要复用 git push/admin token，也不要依赖 ambient GH_TOKEN/GITHUB_TOKEN。
GITHUB_PAGES_GH_TOKEN=
GITHUB_PAGES_DEPLOY_TIMEOUT_SECONDS=600
GITHUB_PAGES_VERIFY_POLL_SECONDS=5
GITHUB_PAGES_READBACK_TIMEOUT_SECONDS=120
GITHUB_PAGES_READBACK_REQUEST_TIMEOUT_SECONDS=10
GITHUB_PAGES_READBACK_MAX_RESPONSE_BYTES=2097152
# 首版自动 verified 只支持 workflow Pages + enforced HTTPS，且 BASE_URL 必须位于
# 仓库 owner 对应的 <owner>.github.io；自定义域名在完成独立 DNS/TLS canary 前只人工核验。
# live 网络 remote 只接受无内嵌凭证的普通 github.com HTTPS/SSH URL；Git transport 通过一次性
# URL alias 固定到已批准目标并显式禁止隐式 tag/submodule/push-option 扩展。请使用 credential helper
# 或 SSH agent，不要把 token 写入 remote URL。gh API 不继承 ambient proxy/CA 配置。
# 安全默认：只生成预览，不写文件/构建/git push。
# gh 验证关闭时，live 模式的 remote SHA 仍只证明 source branch 接受 commit。
GITHUB_PAGES_DRY_RUN=true

# ====== 通知（可选）======
# 两者都是当前部署的全局通知目标，不会按 Account owner 自动发私聊；目前仅发布成功/失败和
# 账号过期事件已接线，内容污点与 fanout 完成仍是规划项。
FEISHU_WEBHOOK_URL=
LARK_CLI_CHAT_IDS=
NOTIFY_BACKEND=both

# ====== API ======
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
# 对外暴露前必须设置非空强随机值。它只用于 legacy 管理端点；不要交给 Agent。
# 不要把真实值提交到 Git，也不要与下面任何 bearer token 复用。
API_KEY=
# Empty API_KEY is fail closed. Set true only for loopback-only local legacy UI/API use.
LEGACY_DEV_AUTH_BYPASS=false
# Agent contract v1 的独立身份配置。值是 JSON 数组，只保存 raw token 的小写 SHA-256，
# 不保存 token 本身；空数组表示 /v1 Bearer 鉴权始终拒绝。完整示例见
# docs/agent-contract.md。approval:read / approval:decide 只能授予 type=human 的独立 principal。
AGENT_PRINCIPALS=[]
# `/v1/contents` 只能导入此目录中的普通文件，并复制到独立的内容寻址 vault。
AGENT_ASSET_IMPORT_ROOT=./data/agent-import
AGENT_ASSET_VAULT_ROOT=./data/agent-vault
# 单文件上限；一份 v1 内容快照的全部素材还受下面的聚合上限约束，且聚合上限不能更小。
AGENT_ASSET_MAX_BYTES=536870912
AGENT_ASSET_MAX_TOTAL_BYTES=2147483648
# Manual metrics collection is cancelled before its durable operation lease
# expires; stale leases can then be reclaimed with the same idempotency key.
AGENT_METRICS_COLLECTION_TIMEOUT_SECONDS=120
AGENT_EXTERNAL_OPERATION_LEASE_SECONDS=300
AUTO_UPGRADE_DB=false

# ====== 可观测性（可选）======
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
LOG_FORMAT=text
LOG_LEVEL=INFO
